{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muniko Share",
  "version": "0.1.2",
  "identifier": "app.muniko.share",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muniko Share",
        "width": 520,
        "height": 720,
        "minWidth": 400,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Any file",
        "ext": [],
        "mimeType": "application/octet-stream",
        "role": "Viewer",
        "contentTypes": [
          "public.data"
        ]
      },
      {
        "name": "Folder",
        "ext": [],
        "mimeType": "inode/directory",
        "role": "Viewer",
        "contentTypes": [
          "public.folder"
        ]
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "installer/desktop.template"
      },
      "rpm": {
        "desktopTemplate": "installer/desktop.template"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ayesh96/MunikoShare/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQUMyQ0Q0RDUzNTNBNDYKUldSR09qWFYxQ3lzZXFQaWZCOWZRVEVXbFF2T1l6UDJiSmc2VDhBdlJLaEc1SWlvOElyT1Z2NS8K"
    }
  }
}
